# Copie este arquivo para ".env" (na mesma pasta) e preencha DATABASE_URL
# com a conexão do seu PostgreSQL local.

# Porta em que o servidor da API vai rodar (padrão: 8080, conforme replit.md)
PORT=8080

# String de conexão do PostgreSQL. Exemplo para um Postgres local padrão:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/viewcoin
DATABASE_URL=
