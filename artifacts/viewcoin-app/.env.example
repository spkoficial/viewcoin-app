# Copie este arquivo para ".env" (na mesma pasta) e ajuste se necessário.
# Todos os valores abaixo já têm defaults sensatos no vite.config.ts,
# então .env é opcional para rodar localmente.

# Porta em que o Vite (frontend) vai rodar
PORT=5173

# Base path do app (mantenha "/" a menos que vá hospedar em um subpath)
BASE_PATH=/

# Porta em que o @workspace/api-server está rodando — usada pelo proxy
# do Vite para redirecionar chamadas de /api/* para o backend.
API_PORT=8080
